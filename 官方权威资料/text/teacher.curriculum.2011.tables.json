[
    {
        "table":  1,
        "cells":  [
                      {
                          "row":  1,
                          "column":  1,
                          "text":  "目标\r领域"
                      },
                      {
                          "row":  1,
                          "column":  2,
                          "text":  "目标"
                      },
                      {
                          "row":  1,
                          "column":  3,
                          "text":  "基本要求"
                      },
                      {
                          "row":  2,
                          "column":  1,
                          "text":  "1\r教\r育\r信\r念\r与\r责\r任"
                      },
                      {
                          "row":  2,
                          "column":  2,
                          "text":  "1.1具有正确的儿童观和相应的行为"
                      },
                      {
                          "row":  2,
                          "column":  3,
                          "text":  "1.1.1理解幼儿阶段在人生发展中的独特地位和价值，认识健康愉快的幼儿园生活对幼儿发展的意义。\r1.1.2尊重和维护幼儿的人格和权利，保护幼儿的好奇心和自信心。\r1.1.3尊重幼儿的个体差异，相信幼儿具有发展的潜力，乐于为幼儿创造发展的条件和机会。"
                      },
                      {
                          "row":  3,
                          "column":  2,
                          "text":  "1.2具有正确的教师观和相应的行为"
                      },
                      {
                          "row":  3,
                          "column":  3,
                          "text":  "1.2.1理解教师是幼儿学习的引导者和支持者，相信教师工作的意义在于帮助幼儿健康成长。\r1.2.2了解幼儿园教师的职业特点和专业要求，自觉提高自身的科学与人文素养，形成终身学习的意愿。\r1.2.3了解教师的权利和责任，遵守教师职业道德。"
                      },
                      {
                          "row":  4,
                          "column":  2,
                          "text":  "1.3具有正确的教育观和相应的行为"
                      },
                      {
                          "row":  4,
                          "column":  3,
                          "text":  "1.3.1理解教育对幼儿成长、教师自身发展和社会进步的重要意义，相信教育充满了创造的乐趣，愿意从事幼儿教育事业。\r1.3.2了解幼儿教育的历史、现状和发展趋势，认同素质教育理念，理解并参与教育改革。\r1.3.3形成正确的教育质量观，对与幼儿教育相关的现象进行专业思考与判断。"
                      },
                      {
                          "row":  5,
                          "column":  1,
                          "text":  "2\r教\r育\r知\r识\r与\r能\r力"
                      },
                      {
                          "row":  5,
                          "column":  2,
                          "text":  "2.1具有理解幼儿的知识和能力"
                      },
                      {
                          "row":  5,
                          "column":  3,
                          "text":  "2.1.1了解儿童发展的主要理论和儿童研究的最新成果。\r2.1.2了解儿童身心发展的一般规律和影响因素，熟悉幼儿年龄阶段特征和个体发展的差异性。\r2.1.3了解幼儿认知发展、学习方式的特点及影响因素，熟悉幼儿建构知识、获得技能的过程。\r2.1.4了解幼儿情感、社会性发展的特点，熟悉幼儿品德和行为习惯形成的过程和规律。 \r2.1.5掌握观察、谈话、倾听、作品分析等基本方法，理解幼儿发展的需要。\r2.1.6了解幼儿期常见疾病、发展障碍、学习障碍的基础知识和应对方法。\r2.1.7了解我国教育的政策法规，熟悉关于儿童权利的内容以及维护儿童合法权益的途径。"
                      },
                      {
                          "row":  6,
                          "column":  2,
                          "text":  "2.2具有教育幼儿的知识和能力"
                      },
                      {
                          "row":  6,
                          "column":  3,
                          "text":  "2.2.1了解我国幼儿园教育的目标和任务，熟悉健康、语言、社会、科学、艺术等各领域的教育目标，学会以此指导自己的学习和实践。\r2.2.2了解幼儿教育的基本原理，理解整合各领域的内容、综合地实施教育活动的重要性，学会设计和实施幼儿教育活动。\r2.2.3了解幼儿的生活经验，学会利用实践机会，积累引导幼儿在游戏等活动中建构知识、发展创造力的经验。\r2.2.4掌握照顾幼儿健康地、安全地生活的基本方法和技能。\r2.2.5了解教育评价的理论与技术，学会通过评价改进活动与促进幼儿发展。\r2.2.6了解与家庭、社区沟通的重要性，学会利用和开发周围的资源，创设有利于幼儿发展的环境。\r2.2.7掌握幼儿心理健康教育的基本知识，学会处理幼儿常见行为问题。\r2.2.8了解0-3岁保育教育的有关知识和婴儿保育教育的一般方法。\r2.2.9了解小学教育的有关知识和幼小衔接的一般方法。"
                      },
                      {
                          "row":  7,
                          "column":  2,
                          "text":  "2.3具有发展自我的知识与能力"
                      },
                      {
                          "row":  7,
                          "column":  3,
                          "text":  "2.3.1了解教师专业素养的核心内容，明确自身专业发展的重点。\r2.3.2了解教师专业发展的阶段与途径，熟悉教师专业发展规划的一般方法，学会理解与分享优秀教师的成功经验。\r2.3.3了解教师专业发展的影响因素，学会利用以课程学习为主的各种机会，积累发展经验。"
                      },
                      {
                          "row":  8,
                          "column":  1,
                          "text":  "3\r教\r育\r实\r践\r与\r体\r验"
                      },
                      {
                          "row":  8,
                          "column":  2,
                          "text":  "3.1具有观摩教育实践的经历与体验"
                      },
                      {
                          "row":  8,
                          "column":  3,
                          "text":  "3.1.1结合相关课程学习，观摩幼儿的生活和教育活动的组织与指导，了解幼儿园教育的规范与过程，感受不同的教育风格。\r3.1.2深入幼儿园和班级，参与幼儿活动，获得与幼儿直接交往的体验。\r3.1.3了解幼儿园保教工作的特点和幼儿园各部门工作的职责和要求，感受幼儿教育实践的丰富性和复杂性。"
                      },
                      {
                          "row":  9,
                          "column":  2,
                          "text":  "3.2具有参与教育实践的经历与体验"
                      },
                      {
                          "row":  9,
                          "column":  3,
                          "text":  "3.2.1了解实习班级幼儿的实际情况，在指导下设计教育活动方案，组织一日活动，获得对教育过程的真实感受。\r3.2.2 参与各种教研活动，获得与幼儿园教师直接对话或交流的机会。 \r3.2.3与家庭和社区合作，提高沟通能力，获得共同促进幼儿发展的实践经历与体验。\r3.2.4参与不同类型的幼教机构活动和幼儿教育实践活动。"
                      },
                      {
                          "row":  10,
                          "column":  2,
                          "text":  "3.3 具有研究教育实践的经历与体验"
                      },
                      {
                          "row":  10,
                          "column":  3,
                          "text":  "3.3.1在日常学习和实践过程中积累所学所思所想，形成问题意识和一定的解决问题的能力。\r3.3.2 了解研究教育实践的一般方法，经历和体验制订计划、开展活动、完成报告、分享结果的过程。\r3.3.3参与各种类型的科研活动，获得科学地研究幼儿的经历与体验。"
                      }
                  ]
    },
