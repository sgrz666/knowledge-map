    {
        "table":  5,
        "cells":  [
                      {
                          "row":  1,
                          "column":  1,
                          "text":  "目标领域"
                      },
                      {
                          "row":  1,
                          "column":  2,
                          "text":  "目标"
                      },
                      {
                          "row":  1,
                          "column":  3,
                          "text":  "基本要求"
                      },
                      {
                          "row":  2,
                          "column":  1,
                          "text":  "1\r教\r育\r信\r念\r与\r责\r任"
                      },
                      {
                          "row":  2,
                          "column":  2,
                          "text":  "1.1具有正确的学生观和相应的行为"
                      },
                      {
                          "row":  2,
                          "column":  3,
                          "text":  "1.1.1理解中学阶段在人生发展中的独特地位和价值，认识积极主动的中学生活对中学生发展的意义。\r1.1.2尊重学生的学习和发展的权利，保护学生的学习自主性、独立性与选择性。\r1.1.3尊重学生的个体差异，相信学生具有发展的潜力，乐于为学生创造发展的条件和机会。"
                      },
                      {
                          "row":  3,
                          "column":  2,
                          "text":  "1.2具有正确的教师观和相应的行为"
                      },
                      {
                          "row":  3,
                          "column":  3,
                          "text":  "1.2.1理解教师是学生学习的促进者，相信教师工作的意义在于创造条件帮助学生自主发展。\r1.2.2了解中学教师的职业特点和专业要求，自觉提高自身的科学与人文素养，形成终身学习的意愿。\r1.2.3了解教师的权利与责任，遵守教师职业道德。"
                      },
                      {
                          "row":  4,
                          "column":  2,
                          "text":  "1.3具有正确的教育观和相应的行为"
                      },
                      {
                          "row":  4,
                          "column":  3,
                          "text":  "1.3.1理解教育对学生成长、教师自身发展和社会进步的重要意义，相信教育充满了创造的乐趣，愿意从事中学教育事业。\r1.3.2了解人类教育的历史、现状和发展趋势，认同素质教育理念，理解并参与教育改革。\r1.3.3形成正确的教育质量观，对与学校教育相关的现象进行专业思考与判断。"
                      },
                      {
                          "row":  5,
                          "column":  1,
                          "text":  "2\r教\r育\r知\r识\r与\r能\r力"
                      },
                      {
                          "row":  5,
                          "column":  2,
                          "text":  "2.1具有理解学生的知识与技能"
                      },
                      {
                          "row":  5,
                          "column":  3,
                          "text":  "2.1.1了解儿童发展的主要理论和最新研究成果。\r2.1.2了解儿童身心发展的一般规律和影响因素，熟悉中学生年龄特征和个体发展的差异性。\r2.1.3了解中学生的认知发展、学习方式的特点及影响因素，熟悉中学生建构知识和获得技能的过程。\r2.1.4了解中学生品德和行为习惯形成的过程，了解中学生交往的特点，理解同伴交往对中学生发展的影响。\r2.1.5掌握观察、谈话、倾听、作品分析等方法，理解中学生学习和发展的需要。\r2.1.6了解我国教育的政策法规，熟悉关于儿童权利的内容以及维护儿童合法权益的途径。"
                      },
                      {
                          "row":  6,
                          "column":  2,
                          "text":  "2.2具有教育学生的知识和能力"
                      },
                      {
                          "row":  6,
                          "column":  3,
                          "text":  "2.2.1了解中学教育的培养目标，熟悉任教学科的课程标准，学会依据课程标准制定教学目标或活动目标。\r2.2.2熟悉任教学科的教学内容和方法，学会联系并运用中学生生活经验和相关课程资源，设计教育活动，创设促进中学生学习的课堂环境。\r2.2.3了解课堂评价的理论与技术，学会通过评价改进教学与促进学生学习。\r2.2.4了解活动课程开发的知识，学会开发校本课程，设计与指导课外、校外活动。\r2.2.5了解班级管理的基本方法，学会引导中学生进行自我管理和形成集体观念。\r2.2.6了解中学生心理健康教育的基本知识，学会处理中学生特别是青春期常见的心理和行为问题。\r2.2.7掌握教师所必需的语言技能、沟通与合作技能、运用现代教育技术的技能。"
                      },
                      {
                          "row":  7,
                          "column":  2,
                          "text":  "2.3具有发展自我的知识与能力"
                      },
                      {
                          "row":  7,
                          "column":  3,
                          "text":  "2.3.1了解教师专业素养的核心内容，明确自身专业发展的重点。\r2.3.2了解教师专业发展的阶段与途径，熟悉教师专业发展规划的一般方法，学会理解和分享优秀教师的成长经验。\r2.3.3了解教师专业发展的影响因素，学会利用以课程学习为主的各种机会积累发展的经验。"
                      },
                      {
                          "row":  8,
                          "column":  1,
                          "text":  "3\r教\r育\r实\r践\r与\r体\r验"
                      },
                      {
                          "row":  8,
                          "column":  2,
                          "text":  "3.1具有观摩教育实践的经历与体验"
                      },
                      {
                          "row":  8,
                          "column":  3,
                          "text":  "3.1.1观摩中学课堂教学，了解中学课堂教学的规范与过程，感受不同的教学风格。\r3.1.2深入班级或其他学生组织，了解中学班级管理的内容和要求，获得与学生直接交往的体验。\r3.1.3深入中学，了解中学的组织结构与运作机制。"
                      },
                      {
                          "row":  9,
                          "column":  2,
                          "text":  "3.2具有参与教育实践的经历与体验"
                      },
                      {
                          "row":  9,
                          "column":  3,
                          "text":  "3.2.1 在有指导的情况下，根据学生的特点，设计与实施教学方案，获得对学科教学的真实感受和初步经验。\r3.2.2 在有指导的情况下，参与指导学习、管理班级和组织活动，获得与家庭、社区联系的经历。\r3.2.3 参与各种教研活动，获得与其他教师直接对话或交流的机会。"
                      },
                      {
                          "row":  10,
                          "column":  2,
                          "text":  "3.3具有研究教育实践的经历与体验"
                      },
                      {
                          "row":  10,
                          "column":  3,
                          "text":  "3.3.1在日常学习和实践过程中积累所学所思所想，形成问题意识和一定的解决问题的能力。\r3.3.2了解研究教育实践的一般方法，经历和体验制订计划、开展活动、完成报告、分享结果的过程。\r3.3.3参与各种类型的科研活动，获得科学地研究学生的经历与体验。"
                      }
                  ]
    },
