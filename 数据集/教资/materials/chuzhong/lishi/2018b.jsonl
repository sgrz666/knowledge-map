{"material_id": "ntce.chuzhong.lishi.2018b.q28.material.recovered", "text": "材料： 某实习生在对“统一多民族国家的巩固和发展”一课进行教学设计时，直接从网上下载了下面的《清时期全图》，准备用于教学。", "source_files": [{"path": "教资/真题/初中真题/2018年下半年教师资格证考试《初中历史》题.csv", "role": "material_raw", "sha256": "229e305b53186d565abc9b8fa4758b21f1fe27278abe83b843d426028d906ef9", "locator": {"decoded_csv_character_start": 2855, "decoded_csv_character_end": 2917, "next_source_question_number": 30, "alignment_status": "unique_task_excerpt_with_preceding_case_section"}}, {"path": "教资/真题/初中真题/2018年下半年教师资格证考试《初中历史》题.csv", "role": "question_raw", "locator": {"paper_order": 28, "alignment_status": "pending"}, "sha256": "229e305b53186d565abc9b8fa4758b21f1fe27278abe83b843d426028d906ef9"}], "review": {"content_verified": false, "status": "auto_parsed", "extraction_status": "source_interval_recovered_pending_expert"}, "question_ids": ["ntce.chuzhong.lishi.2018b.q28"], "knowledge_node_ids": ["ntce.chuzhong.lishi.s1.k09", "ntce.chuzhong.lishi.s1.k10", "ntce.chuzhong.lishi.s3.k03"], "ability_ids": ["ntce.chuzhong.ability.design", "ntce.chuzhong.ability.subject"], "exam_requirement_ids": ["ntce.outline.310.r001", "ntce.outline.310.r002", "ntce.outline.310.r009", "ntce.outline.316.r004", "ntce.outline.316.r010", "ntce.outline.316.r017"], "used_by_questions": ["ntce.chuzhong.lishi.2018b.q28"], "word_count": 61, "level": "chuzhong", "subject": "lishi", "kind": "case_material", "source": {"origin_file": "教资/真题/初中真题/2018年下半年教师资格证考试《初中历史》题.csv", "files": [{"path": "教资/真题/初中真题/2018年下半年教师资格证考试《初中历史》题.csv", "role": "material_raw", "sha256": "229e305b53186d565abc9b8fa4758b21f1fe27278abe83b843d426028d906ef9", "locator": {"decoded_csv_character_start": 2855, "decoded_csv_character_end": 2917, "next_source_question_number": 30, "alignment_status": "unique_task_excerpt_with_preceding_case_section"}}, {"path": "教资/真题/初中真题/2018年下半年教师资格证考试《初中历史》题.csv", "role": "question_raw", "locator": {"paper_order": 28, "alignment_status": "pending"}, "sha256": "229e305b53186d565abc