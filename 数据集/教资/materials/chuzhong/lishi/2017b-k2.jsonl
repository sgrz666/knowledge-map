{"material_id": "ntce.chuzhong.lishi.2017b-k2.q31.material.recovered", "text": "某教师为《中国早期人类的代表一北京人》的教学，布置了如下的课后作业：参观历史博物馆，查阅图书资料并结合课文内容，自拟题目，比较一下古猿、北京人与现代人的区别，书面作答。", "source_files": [{"path": "教资/真题/初中真题/2017年下半年教师资格证考试《初中历史》题.csv", "role": "material_raw", "sha256": "da26ad6da9e15afa4dc03a8254b24d15a842eab68222559433931f7ca44ed3d3", "locator": {"decoded_csv_character_start": 3182, "decoded_csv_character_end": 3266, "next_source_question_number": 31, "alignment_status": "unique_task_excerpt_with_preceding_case_section"}}, {"path": "教资/真题/初中真题/2017年下半年教师资格证考试《初中历史》题.csv", "role": "question_raw", "locator": {"paper_order": 31, "alignment_status": "pending"}, "sha256": "da26ad6da9e15afa4dc03a8254b24d15a842eab68222559433931f7ca44ed3d3"}], "review": {"content_verified": false, "status": "auto_parsed", "extraction_status": "source_interval_recovered_pending_expert"}, "question_ids": ["ntce.chuzhong.lishi.2017b-k2.q31"], "knowledge_node_ids": ["ntce.chuzhong.lishi.s1.k10", "ntce.chuzhong.lishi.s3.k03", "ntce.chuzhong.lishi.s4.k02"], "ability_ids": ["ntce.chuzhong.ability.design", "ntce.chuzhong.ability.evaluate", "ntce.chuzhong.ability.manage", "ntce.chuzhong.ability.subject"], "exam_requirement_ids": ["ntce.outline.310.r001", "ntce.outline.310.r009", "ntce.outline.310.r019", "ntce.outline.316.r010", "ntce.outline.316.r017"], "used_by_questions": ["ntce.chuzhong.lishi.2017b-k2.q31"], "word_count": 84, "level": "chuzhong", "subject": "lishi", "kind": "case_material", "source": {"origin_file": "教资/真题/初中真题/2017年下半年教师资格证考试《初中历史》题.csv", "files": [{"path": "教资/真题/初中真题/2017年下半年教师资格证考试《初中历史》题.csv", "role": "material_raw", "sha256": "da26ad6da9e15afa4dc03a8254b24d15a842eab68222559433931f7ca44ed3d3", "locator": {"decoded_csv_character_start": 3182, "decoded_csv_character_end": 3266, "next_source_question_number": 31, "alignment_status": "unique_task_excerpt_with_preceding_case_section"}}, {"path": "教资/真题/初中真题/2017年下半年教师资格证考试《初中历史》题.csv", "role": "question_raw", "locator": {"paper_or