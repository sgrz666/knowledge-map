{"material_id": "ntce.chuzhong.lishi.2018a.q26.material.recovered", "text": "材料：某青年教师在讲授“两汉的科技与文化”一课后，设计了一个参观考察活动的方案。该教师将方案交给教研组长审阅，组长建议修改。", "source_files": [{"path": "教资/真题/初中真题/2018年上半年教师资格证考试《初中历史》题.csv", "role": "material_raw", "sha256": "f68ca3d49b6ccc5a0ca80df5a2f2a3fc37500a3dcd78ab8d1b6e47bb93cddb65", "locator": {"decoded_csv_character_start": 2969, "decoded_csv_character_end": 3031, "next_source_question_number": 30, "alignment_status": "unique_task_excerpt_with_preceding_case_section"}}, {"path": "教资/真题/初中真题/2018年上半年教师资格证考试《初中历史》题.csv", "role": "question_raw", "locator": {"paper_order": 26, "alignment_status": "pending"}, "sha256": "f68ca3d49b6ccc5a0ca80df5a2f2a3fc37500a3dcd78ab8d1b6e47bb93cddb65"}], "review": {"content_verified": false, "status": "auto_parsed", "extraction_status": "source_interval_recovered_pending_expert"}, "question_ids": ["ntce.chuzhong.lishi.2018a.q26"], "knowledge_node_ids": ["ntce.chuzhong.lishi.s1.k03", "ntce.chuzhong.lishi.s1.k09", "ntce.chuzhong.lishi.s1.k10"], "ability_ids": ["ntce.chuzhong.ability.subject"], "exam_requirement_ids": ["ntce.outline.310.r001", "ntce.outline.310.r002", "ntce.outline.316.r004"], "used_by_questions": ["ntce.chuzhong.lishi.2018a.q26"], "word_count": 62, "level": "chuzhong", "subject": "lishi", "kind": "case_material", "source": {"origin_file": "教资/真题/初中真题/2018年上半年教师资格证考试《初中历史》题.csv", "files": [{"path": "教资/真题/初中真题/2018年上半年教师资格证考试《初中历史》题.csv", "role": "material_raw", "sha256": "f68ca3d49b6ccc5a0ca80df5a2f2a3fc37500a3dcd78ab8d1b6e47bb93cddb65", "locator": {"decoded_csv_character_start": 2969, "decoded_csv_character_end": 3031, "next_source_question_number": 30, "alignment_status": "unique_task_excerpt_with_preceding_case_section"}}, {"path": "教资/真题/初中真题/2018年上半年教师资格证考试《初中历史》题.csv", "role": "question_raw", "locator": {"paper_order": 26, "alignment_status": "pending"}, "sha256": "f68ca3d49b6ccc5a0ca80df5a2f2a3fc37500a3dcd78ab8d1b6e47bb93cddb65"}], "type": "真题", "copyright": {"authorization_status": "unkn