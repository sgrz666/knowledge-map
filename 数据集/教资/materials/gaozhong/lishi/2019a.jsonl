{"material_id": "ntce.gaozhong.lishi.2019a.q30.material.recovered", "text": "材料一：课文摘录：《普通高中历史课程标准（2017年版）》规定：通过了解三国两晋南北朝政权更迭的历史脉络，隋唐时期封建社会的高度繁荣，认识三国两晋南北朝至隋唐时期的制度变化与创新，民族交融、区域开发和思想文化领域的新成就。材料二：王羲之《姨母帖》顾恺之《洛神赋图》敦煌莫高窟壁画《胡旋舞》", "source_files": [{"path": "教资/真题/高中真题/2019年上半年教师资格证考试《高中历史》题.csv", "role": "material_raw", "sha256": "dae99a902fd7a024a9818b0b12385cfbdfa69b1b0a44425fd2494e30d0fe0696", "locator": {"decoded_csv_character_start": 3526, "decoded_csv_character_end": 3670, "next_source_question_number": 32, "alignment_status": "unique_task_excerpt_with_preceding_case_section"}}, {"path": "教资/真题/高中真题/2019年上半年教师资格证考试《高中历史》题.csv", "role": "question_raw", "locator": {"paper_order": 30, "alignment_status": "pending"}, "sha256": "dae99a902fd7a024a9818b0b12385cfbdfa69b1b0a44425fd2494e30d0fe0696"}], "review": {"content_verified": false, "status": "auto_parsed", "extraction_status": "source_interval_recovered_pending_expert"}, "question_ids": ["ntce.gaozhong.lishi.2019a.q30"], "knowledge_node_ids": ["ntce.gaozhong.lishi.s1.k01", "ntce.gaozhong.lishi.s2.k01", "ntce.gaozhong.lishi.s3.k03"], "ability_ids": ["ntce.gaozhong.ability.design", "ntce.gaozhong.ability.subject", "ntce.gaozhong.ability.theory"], "exam_requirement_ids": ["ntce.outline.410.r004", "ntce.outline.410.r009"], "used_by_questions": ["ntce.gaozhong.lishi.2019a.q30"], "word_count": 144, "level": "gaozhong", "subject": "lishi", "kind": "lesson_plan_material", "source": {"origin_file": "教资/真题/高中真题/2019年上半年教师资格证考试《高中历史》题.csv", "files": [{"path": "教资/真题/高中真题/2019年上半年教师资格证考试《高中历史》题.csv", "role": "material_raw", "sha256": "dae99a902fd7a024a9818b0b12385cfbdfa69b1b0a44425fd2494e30d0fe0696", "locator": {"decoded_csv_character_start": 3526, "decoded_csv_character_end": 3670, "next_source_question_number": 32, "alignment_status": "unique_task_excerpt_with_preceding_case_section"}}, {"path": "教资/真题/高中真题/2019年上半年教师资格证考试《高中历史》题.csv", "role": "question_raw", "locator": {"paper_order": 30, "alignment_status": "pending"}, "sha256"