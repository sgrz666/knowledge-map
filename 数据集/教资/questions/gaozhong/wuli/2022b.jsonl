view": {"status": "quarantined", "tagger": "content-rule-v2", "content_verified": false}, "copyright": {"authorization_status": "unknown", "holder": null, "use_scope": "research_non_commercial", "expires_at": null, "source_nature": "official_exam", "nature_note": "教育主管部门公开发布的考试试题", "nature_evidence": "filename_pattern:官方真题命名", "attribution_required": false}}, "analysis": {"method": "rule_kb_draft", "correct_answer": null, "key_info": "题干要求：分）（2）用此实验设计一个教学片段，帮助学生理解与该现象相关的物理知识。（8分）（二）阅读材料，根据要求完成教学设计。材料一：《普通高中物理课程标准（2017年版2020年修订）》关于“光及其应用”的内容标准为“观察光的干涉、衍射和偏振现象，了解这些现象产生的条件，知道其在生产生活中的应用”。材料二：高中物理某版本教材“光的衍射”一节的部分教学内容如下。光的衍射在挡板上安装一个宽度可调的狭缝，缝后放一个光屏。用单色平行光照射狭缝，我们看到，当缝比较宽时，光沿着直线通过狭缝，在屏上产生一条与缝宽相当的亮条纹。但是，当缝调到很窄时，尽管亮条纹的亮度有所降低，但是宽度反而增大了，而且还出现了明暗相间的条纹（图4.。（关联知识点：教学活动与问题链设计、教学资源与板书设计、振动与波）", "option_compare": null, "trace_back": "关联知识点：教学活动与问题链设计、教学资源与板书设计、振动与波；关键词：共振、声波、多媒体、实验设计、导入、干涉、振动、教具", "explanation": "本题为主观题，需结合知识点【教学活动与问题链设计、教学资源与板书设计、振动与波】与题干情境展开作答。以下为作答要点方向（框架推导，非官方标准答案，待专家核定），要点可围绕：共振、声波、多媒体、实验设计、导入、干涉、振动、教具；本题已生成 7 条框架评分要点（框架推导，非官方答案）。", "knowledge_node_ids": ["ntce.gaozhong.wuli.s3.k03", "ntce.gaozhong.wuli.s3.k04", "ntce.gaozhong.wuli.s1.k05"], "ability_ids": ["ntce.gaozhong.ability.design", "ntce.gaozhong.ability.subject"], "exam_requirement_ids": ["ntce.outline.406.r005", "ntce.outline.406.r006", "ntce.outline.406.r013", "ntce.outline.406.r014", "ntce.outline.406.r020"], "status": "rule_draft_pending_expert", "expert_verified": false, "source_note": "规则+知识库节点生成，未调用模型；非官方答案，待专家核定。"}, "rubric_id": "rubric.ntce.gaozhong.wuli.2022b.q03", "school_level": "gaozhong", "module": "物理"}
