{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledge-map:ability-dimension:1.0",
  "title": "AbilityDimension",
  "description": "能力素养维度Schema（对应规范附录A.4）",
  "type": "object",
  "required": ["ability_id", "name", "exam"],
  "properties": {
    "ability_id": {
      "type": "string",
      "description": "如 ab.cet.read.infer 或 ntce.chuzhong.ability.subject"
    },
    "name": {
      "type": "string",
      "description": "推理判断能力 / 教学设计能力 / 学科专业能力"
    },
    "exam": {
      "type": "string"
    },
    "category": {
      "type": ["string", "null"],
      "description": "所属宏观素养领域"
    },
    "standard_descriptors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "关联的 CSE 描述语或师范生专业标准条目"
    },
    "inheritance": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
